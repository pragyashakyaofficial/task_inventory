# .env.example
# Copy this file to .env.dev, .env.staging, and .env.prod

# API Configuration
API_BASE_URL=https://api.example.com/v1
API_TIMEOUT=10000

# Auth Configuration
AUTH_TOKEN_KEY=authToken
REFRESH_TOKEN_KEY=refreshToken

# Feature Flags
ENABLE_AI_SUGGESTIONS=true
ENABLE_ANALYTICS=false

# External Services
SENTRY_DSN=
AMPLITUDE_API_KEY=
